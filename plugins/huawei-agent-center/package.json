{
  "name": "@ora-space/huawei-agent-center-ui",
  "version": "0.1.0",
  "description": "Ora UI plugin that embeds the Huawei Agent Center.",
  "type": "module",
  "license": "Apache-2.0",
  "ora": {
    "manifestVersion": 1,
    "id": "ora-space.huawei-agent-center",
    "displayName": "Huawei Agent Center",
    "kind": "ui",
    "main": "./src/main.ts",
    "engines": { "ora": ">= 0.9.0", "pluginApi": 1, "bun": ">= 1.0.0" },
    "contributes": {
      "ui": {
        "contractVersion": 1,
        "surfaces": [
          {
            "id": "market",
            "title": "Huawei Agent Center",
            "instancePolicy": "singleton",
            "source": {
              "kind": "remoteSite",
              "entryUrl": "https://ai.edevops.huawei.com/mcp/projects",
              "navigation": { "allowHostSuffixes": ["huawei.com"] },
              "webData": "persistentProfile"
            }
          }
        ]
      }
    }
  }
}
