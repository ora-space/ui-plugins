{
  "name": "@ora-space/hello-panel-ui",
  "version": "0.1.0",
  "description": "Ora UI plugin sample: a package-shipped panel whose clicks round-trip through the plugin process.",
  "type": "module",
  "license": "Apache-2.0",
  "ora": {
    "manifestVersion": 1,
    "id": "ora-space.hello-panel",
    "displayName": "Hello Panel",
    "kind": "ui",
    "main": "./src/main.ts",
    "engines": { "ora": ">= 0.9.0", "pluginApi": 1, "bun": ">= 1.0.0" },
    "contributes": {
      "ui": {
        "contractVersion": 1,
        "surfaces": [
          {
            "id": "counter",
            "title": "Hello Panel",
            "instancePolicy": "singleton",
            "source": { "kind": "panel", "root": "ui", "entry": "index.html" }
          }
        ]
      }
    }
  }
}
