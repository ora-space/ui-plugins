# Local clone of the marketplace repository that `deno task publish` commits to.
MARKETPLACE_DIR=/data/code/zxh/marketplace
# Remote the release branch is pushed to (a fork is fine) and the remote/branch
# the entry is based on. BASE_REMOTE defaults to PUSH_REMOTE.
MARKETPLACE_PUSH_REMOTE=origin
MARKETPLACE_BASE_REMOTE=upstream
MARKETPLACE_BASE_BRANCH=main
# Repository the pull request targets and the repository whose GitHub Release
# hosts the .orax assets. Override both only when rehearsing against forks.
MARKETPLACE_REPO=ora-space/marketplace
RELEASE_REPO=ora-space/ui-plugins
